{
    "name": "3d-connect-four",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "dev:model": "wrangler r2 object put 3d-connect-four-models/model.onnx --file public/static/nn/model.onnx --local",
        "upload:model": "wrangler r2 object put 3d-connect-four-models/model.onnx --file public/static/nn/model.onnx --remote",
        "deploy": "wrangler deploy",
        "test": "node --test tests/*.test.mjs"
    },
    "devDependencies": {
        "wrangler": "^4.40.0"
    }
}
