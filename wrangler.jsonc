{
	"name": "3d-connect-four",
	"main": "worker/index.js",
	"compatibility_date": "2025-09-01",
	"assets": {
		"directory": "public",
		"binding": "ASSETS"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOMS",
				"class_name": "Room"
			},
			{
				"name": "LOBBY",
				"class_name": "Lobby"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Room",
				"Lobby"
			]
		}
	],
	"r2_buckets": [
		{
			"binding": "MODELS",
			"bucket_name": "3d-connect-four-models"
		}
	]
}